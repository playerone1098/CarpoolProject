# ============================================================
# CarpoolProject - Local Development Environment
# ALL values here are MOCK/LOCAL defaults. No real secrets.
# Copy this file to .env:  cp .env.example .env
# ============================================================

PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration (local only)
DB_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carpool

# Optional: Set full connection URL instead of individual parameters
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/carpool

# For zero-dependency offline local test without running PostgreSQL server:
# DB_TYPE=sqlite
# SQLITE_DB=carpool_dev.sqlite

# Automatically seed rich local mock data when the database is empty
AUTO_SEED=true

# JWT Authentication (mock local key - NOT for production)
JWT_SECRET=local-dev-jwt-secret-mock-only

# Redis Instance (Optional - Leave commented to use built-in In-Memory Cache)
# REDIS_URL=redis://127.0.0.1:6379

# Web Push Notifications (placeholder values - push is disabled when these are set)
VAPID_PUBLIC_KEY=placeholder-vapid-public-key
VAPID_PRIVATE_KEY=placeholder-vapid-private-key
VAPID_SUBJECT=mailto:dev@localhost
