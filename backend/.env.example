PORT=4000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_TYPE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carpool

# Optional: Set full connection URL instead of individual parameters
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/carpool

# For zero-dependency offline local test without running PostgreSQL server:
# DB_TYPE=sqlite
# SQLITE_DB=carpool_dev.sqlite

# Automatically seed rich local mock data when the database is empty
AUTO_SEED=true

# JWT Authentication
JWT_SECRET=local-dev-jwt-secret-key-do-not-use-in-production

# Redis Instance (Optional - Leave commented to use built-in zero-dependency In-Memory Cache)
# REDIS_URL=redis://127.0.0.1:6379

# Web Push Notifications (Optional - Leave as placeholders to disable push locally without errors)
VAPID_PUBLIC_KEY=placeholder-vapid-public-key
VAPID_PRIVATE_KEY=placeholder-vapid-private-key
VAPID_SUBJECT=mailto:support@example.com
